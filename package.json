{
  "name": "fffunction",
  "version": "0.1.0",
  "description": "Create polymorphic functions in typescript.",
  "packageManager": "pnpm@9.15.0",
  "main": "dist/index.js",
  "sideEffects": false,
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@vitest/coverage-v8": "3.2.4",
    "rimraf": "6.0.1",
    "ts-pattern": "5.8.0",
    "typescript": "5.9.2",
    "vite": "7.0.6",
    "vitest": "3.2.4"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run --coverage --typecheck && npm run compile",
    "compile": "tsc -p ./tsconfig.test.json --noEmit",
    "format": "biome format --write src tests",
    "lint": "biome lint src tests",
    "lint:fix": "biome lint --write src tests",
    "check": "biome check src tests",
    "check:fix": "biome check --write src tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrgautier/fffunction.git"
  },
  "keywords": [
    "utils",
    "typescript",
    "polymorph",
    "polymorphism",
    "function"
  ],
  "author": "Adrien Gautier",
  "license": "MIT"
}
